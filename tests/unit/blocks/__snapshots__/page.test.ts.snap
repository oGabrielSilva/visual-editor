exports[`block page: generated HTML and CSS > turns global styles into variables and overrides into rules of the block class 1`] = `":root{--ve-body-background:#f3f7f6;--ve-body-content-background:#ffffff;--ve-body-width:1120px;--ve-body-font-family:Arial, Helvetica, sans-serif;--ve-body-text-color:#243746;--ve-body-font-size:16px;--ve-body-line-height:1.65;--ve-body-link-color:#0d766e;--ve-heading-font-family:Arial, Helvetica, sans-serif;--ve-heading-color:#10302c;--ve-heading-font-size:28px;--ve-heading-font-weight:700;--ve-heading-line-height:1.25;--ve-button-background:#0000ff;--ve-button-color:#ffffff;--ve-button-radius:8px;--ve-button-font-size:16px;--ve-button-font-weight:600;--ve-button-padding:12px 24px;--ve-divider-color:#dce4e7;--ve-divider-width:1px;--ve-footer-color:#536674;--ve-footer-font-size:12px;--ve-section-padding:24px 0;--ve-section-column-gap:24px}body{margin:0;background:var(--ve-body-background)}.ve-page{background:var(--ve-body-background);font-family:var(--ve-body-font-family);color:var(--ve-body-text-color);font-size:var(--ve-body-font-size);line-height:var(--ve-body-line-height)}.ve-page *,.ve-page *::before,.ve-page *::after{box-sizing:border-box}.ve-page a{color:var(--ve-body-link-color)}.ve-section{max-width:var(--ve-body-width);margin:0 auto;background-color:var(--ve-body-content-background);padding:var(--ve-section-padding)}.ve-columns{display:grid;grid-template-columns:minmax(0,1fr);column-gap:var(--ve-section-column-gap)}.ve-column{min-width:0;padding:0;align-self:start}.ve-block{padding:10px 25px}.ve-text>:first-child,.ve-footer>:first-child{margin-top:0}.ve-text>:last-child,.ve-footer>:last-child{margin-bottom:0}.ve-heading{margin:0;font-family:var(--ve-heading-font-family);color:var(--ve-heading-color);font-size:var(--ve-heading-font-size);font-weight:var(--ve-heading-font-weight);line-height:var(--ve-heading-line-height)}.ve-footer{color:var(--ve-footer-color);font-size:var(--ve-footer-font-size)}.ve-image{text-align:center}.ve-image img{display:inline-block;max-width:100%;height:auto;border:0}.ve-image-empty{min-height:120px;background:#e8eef0}.ve-button-row{text-align:center}.ve-page .ve-button{display:inline-block;background-color:var(--ve-button-background);color:var(--ve-button-color);border-radius:var(--ve-button-radius);font-size:var(--ve-button-font-size);font-weight:var(--ve-button-font-weight);padding:var(--ve-button-padding);line-height:1.2;text-decoration:none}.ve-divider hr{margin:0;border:0;border-top:var(--ve-divider-width) solid var(--ve-divider-color)}.ve-spacer{height:20px}.ve-html{padding:0}.ve-b-s1 > .ve-columns{grid-template-columns:minmax(0,2fr) minmax(0,1fr)}.ve-b-h1{color:#112233}.ve-b-b1 .ve-button{background-color:#ff0000}.ve-b-i1 img{width:200px}.ve-b-d1 hr{border-top-color:#00ff00}@media (max-width:640px){.ve-section>.ve-columns{grid-template-columns:minmax(0,1fr)}}"`;

exports[`block page: generated HTML and CSS > writes semantic HTML with real columns 1`] = `"<main class="ve-page" lang="es"><section class="ve-section ve-b-s1"><div class="ve-columns"><div class="ve-column ve-b-c1"><h1 class="ve-block ve-heading ve-b-h1">Título</h1><div class="ve-block ve-text ve-b-t1"><p>Texto</p></div><div class="ve-block ve-button-row ve-b-b1"><a class="ve-button" href="#form">Ir</a></div></div><div class="ve-column ve-b-c2"><div class="ve-block ve-image ve-b-i1"><img src="https://x.y/a.png" alt="A"></div><div class="ve-block ve-divider ve-b-d1"><hr></div><div class="ve-spacer ve-b-p1" aria-hidden="true"></div></div></div></section><section class="ve-section ve-b-s2"><div class="ve-columns"><div class="ve-column ve-b-c3"><div class="ve-block ve-form ve-b-f1" data-host-slot="form" data-host-reference="lead_1"></div><div class="ve-html ve-b-r1"><div>Livre</div><script>track()</script></div><footer class="ve-block ve-footer ve-b-o1"><p>Rodapé</p></footer></div></div></section></main>"`;
