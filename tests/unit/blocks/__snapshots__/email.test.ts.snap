exports[`block e-mail: MJML > generates stable MJML with global styles in mj-attributes 1`] = `"<mjml lang="pt-BR"><mj-head><mj-breakpoint width="641px" /><mj-attributes><mj-section background-color="#ffffff" padding="24px 0" /><mj-all font-family="Arial, Helvetica, sans-serif" /><mj-text color="#243746" font-size="16px" line-height="1.65" /><mj-class name="ve-heading" font-family="Arial, Helvetica, sans-serif" color="#10302c" font-size="28px" font-weight="700" line-height="1.25" /><mj-button background-color="#0d766e" color="#ffffff" border-radius="8px" font-size="16px" font-weight="600" inner-padding="12px 24px" /><mj-divider border-color="#dce4e7" border-width="1px" /><mj-class name="ve-footer" color="#536674" font-size="12px" /></mj-attributes><mj-style>a { color: #0d766e; }</mj-style></mj-head><mj-body background-color="#f3f7f6" width="600px"><mj-section><mj-column width="100%"><mj-text mj-class="ve-heading"><h1 style="margin:0;font-family:Arial, Helvetica, sans-serif;font-size:28px;font-weight:700;line-height:1.25;color:#10302c">Olá, <em>Nico</em></h1></mj-text><mj-text><p>Primeiro <a href="https://x.y/?a=1&amp;b=2">link</a></p></mj-text><mj-image src="https://x.y/a.png" alt="Foto &quot;x&quot;" href="https://x.y"></mj-image><mj-button href="https://x.y/comprar">Comprar</mj-button><mj-divider></mj-divider><mj-spacer height="32px"></mj-spacer><mj-raw><tr><td style="padding:8px 16px"><div style="font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.65;color:#243746"><p>Livre</p></div></td></tr></mj-raw><mj-raw><tr><td style="padding:0"><div style="font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:1.65;color:#243746"><div class="hero" style="color:#ff0000"><!--[if mso]><b>Outlook</b><![endif]--><span>Autor &amp; cia</span></div></div></td></tr></mj-raw></mj-column></mj-section><mj-section><mj-column width="100%"><mj-text mj-class="ve-footer"><p>Rodapé</p></mj-text></mj-column></mj-section></mj-body></mjml>"`;
