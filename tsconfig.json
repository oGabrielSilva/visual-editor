{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "resolveJsonModule": true, "allowSyntheticDefaultImports": true,
    "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "playground/**/*.ts", "playground/**/*.vue", "tests/**/*.ts", "*.config.ts", "auto-imports.d.ts", "components.d.ts"]
}
